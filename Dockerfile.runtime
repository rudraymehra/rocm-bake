# syntax=docker/dockerfile:1
# Minimal PyTorch ROCm runtime image for gfx950
# Receives pre-built PyTorch wheel from pytorch target context

ARG PYTHON_VERSION=3.14
ARG ROCM_VERSION=10.1.0-full

FROM rocm/rocm:rocm_ubuntu24.04_${ROCM_VERSION} AS base

LABEL org.opencontainers.image.source="https://github.com/your-org/rocm-pytorch-build"
LABEL org.opencontainers.image.description="Minimal PyTorch ROCm runtime for gfx950"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install Python and minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-venv \
    libsndfile1 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create venv
ARG PYTHON_VERSION
RUN python${PYTHON_VERSION} -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

ENV PATH=/opt/venv/bin:$PATH

# PyTorch build context - the wheel is copied from the pytorch build image
# In bake.hcl, contexts = { pytorch = "${REGISTRY}/${REGISTRY_NAME}/pytorch:..." }
# The wheel path is /opt/venv/lib/python3.x/site-packages/ inside the pytorch image
FROM base AS runtime

COPY --from=pytorch /opt/venv/lib/python${PYTHON_VERSION}/site-packages/ \
    /opt/venv/lib/python${PYTHON_VERSION}/site-packages/

# ROCm environment
ENV ROCM_PATH=/opt/rocm
ENV PATH=${ROCM_PATH}/bin:${ROCM_PATH}/hip/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_PATH}/lib:/opt/rocm/lib:$LD_LIBRARY_PATH
ENV HSA_OVERRIDE_GFX_VERSION=11.0.2

# Verify installation
RUN python -c "import torch; print(f'PyTorch {torch.__version__} on {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"no GPU\"}'); exit(0 if torch.cuda.is_available() else 1)"

CMD ["-c", "import torch; print(f'PyTorch {torch.__version__} on {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"no GPU\"}'); exit(0 if torch.cuda.is_available() else 1)"]
